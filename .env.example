# Optional: Provide your preferred LLM provider credentials.
# If none are provided, the harness automatically runs in deterministic offline mock mode
# ensuring 100% reproducible evaluation runs without API charges or rate limits.

# Option 1: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Option 2: Azure OpenAI
AZURE_AI_API_KEY=your_azure_api_key_here
AZURE_AI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_AI_MODEL=gpt-4o

# Option 3: OpenRouter
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=your_openrouter_api_key_here
# OPENAI_MODEL=openai/gpt-4o-mini

# Option 4: Local OpenAI-compatible endpoint (Ollama / vLLM / LocalAI)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
